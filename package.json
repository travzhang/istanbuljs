{
  "name": "@vitest/istanbuljs-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Code Coverage utilities for Vitest and other modern testing frameworks",
  "scripts": {
    "test": "cross-env NODE_ENV=test nyc mocha --timeout 30000 packages/*/test{,/*}.js",
    "posttest": "eslint .",
    "fix": "eslint . --fix",
    "postinstall": "bash scripts/install.sh"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:vitest-dev/istanbuljs.git"
  },
  "keywords": [
    "istanbuljs",
    "vitest",
    "coverage"
  ],
  "author": "Vitest Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vitest-dev/vitest/issues"
  },
  "homepage": "https://vitest.dev/",
  "devDependencies": {
    "babel-eslint": "^10.0.3",
    "coveralls": "^3.0.9",
    "cross-env": "^6.0.3",
    "eslint": "^6.7.2",
    "eslint-config-prettier": "^6.7.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-react": "^7.17.0",
    "glob": "^7.1.6",
    "mocha": "^7.2.0",
    "nyc": "^15.1.0",
    "prettier": "=1.18.2"
  },
  "nyc": {
    "reporter": [
      "text",
      "lcov"
    ]
  },
  "engines": {
    "node": ">=8"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 4
  }
}
