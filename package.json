{
  "name": "@vitest/istanbuljs-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Code Coverage utilities for Vitest and other modern testing frameworks",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "test": "cross-env NODE_ENV=test nyc mocha --timeout 30000 packages/*/test{,/*}.js",
    "posttest": "eslint .",
    "fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:vitest-dev/istanbuljs.git"
  },
  "keywords": [
    "istanbuljs",
    "vitest",
    "coverage"
  ],
  "author": "Vitest Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vitest-dev/vitest/issues"
  },
  "homepage": "https://vitest.dev/",
  "devDependencies": {
    "babel-eslint": "catalog:",
    "coveralls": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "glob": "catalog:",
    "mocha": "catalog:",
    "nyc": "catalog:",
    "prettier": "catalog:"
  },
  "nyc": {
    "reporter": [
      "text",
      "lcov"
    ]
  },
  "engines": {
    "node": ">=8"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 4
  }
}
