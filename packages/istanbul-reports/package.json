{
  "name": "@vitest/istanbul-reports",
  "version": "0.0.0",
  "description": "istanbul reports",
  "keywords": [
    "istanbul",
    "reports",
    "vitest"
  ],
  "homepage": "https://vitest.dev",
  "bugs": {
    "url": "https://github.com/vitest-dev/vitest/issues"
  },
  "license": "MIT",
  "author": "Vitest Team",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/vitest-dev/istanbuljs.git",
    "directory": "packages/istanbul-reports"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "test": "pnpm --filter @vitest/istanbuljs-monorepo run test --project @vitest/istanbul-reports",
    "build:spa": "webpack --config src/html-spa/webpack.config.cjs --mode production",
    "build:spa:watch": "webpack --config src/html-spa/webpack.config.cjs --watch --mode development"
  },
  "dependencies": {
    "@vitest/istanbul-lib-coverage": "workspace:*",
    "@vitest/istanbul-lib-report": "workspace:*",
    "html-escaper": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "babel-loader": "catalog:",
    "is-windows": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
