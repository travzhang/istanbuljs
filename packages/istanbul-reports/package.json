{
  "name": "@vitest/istanbul-reports",
  "version": "0.0.0",
  "description": "istanbul reports",
  "author": "Vitest Team",
  "main": "index.js",
  "files": [
    "index.js",
    "lib"
  ],
  "scripts": {
    "test": "nyc mocha --recursive",
    "prepare": "webpack --config lib/html-spa/webpack.config.js --mode production",
    "prepare:watch": "webpack --config lib/html-spa/webpack.config.js --watch --mode development"
  },
  "dependencies": {
    "html-escaper": "catalog:",
    "@vitest/istanbul-lib-report": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "babel-loader": "catalog:",
    "chai": "catalog:",
    "is-windows": "catalog:",
    "@vitest/istanbul-lib-coverage": "workspace:*",
    "mocha": "catalog:",
    "nyc": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "catalog:"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/vitest-dev/istanbuljs.git",
    "directory": "packages/istanbul-reports"
  },
  "keywords": [
    "istanbul",
    "vitest",
    "reports"
  ],
  "bugs": {
    "url": "https://github.com/vitest-dev/vitest/issues"
  },
  "homepage": "https://vitest.dev",
  "nyc": {
    "exclude": [
      "lib/html/assets/**",
      "lib/html-spa/assets/**",
      "lib/html-spa/rollup.config.js",
      "test/**"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
